<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.Passenger.LoginTitle" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textColor">@color/smartbus_text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Passenger.LoginBody" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/smartbus_text_secondary</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="Widget.Passenger.LoginCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/smartbus_surface</item>
        <item name="cardCornerRadius">@dimen/radius_xl</item>
        <item name="cardElevation">@dimen/elevation_card_raised</item>
        <item name="strokeColor">@color/smartbus_outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Passenger.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_md</item>
        <item name="boxStrokeColor">@color/smartbus_primary</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="hintTextColor">@color/smartbus_text_secondary</item>
        <item name="boxBackgroundColor">@color/smartbus_surface</item>
    </style>

    <style name="Widget.Passenger.Button.Primary" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="android:minHeight">@dimen/button_height_large</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/smartbus_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="iconTint">@color/white</item>
        <item name="iconPadding">10dp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Widget.Passenger.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="strokeColor">@color/smartbus_primary</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/smartbus_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>
</resources>
