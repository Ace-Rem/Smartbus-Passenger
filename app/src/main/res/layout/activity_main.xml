<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootShell"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_passenger_auth"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp">

    <ImageView
        android:id="@+id/authLogoImage"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_passenger_logo_circle"
        android:contentDescription="@string/app_name"
        android:padding="16dp"
        android:src="@drawable/ic_passenger_bus"
        app:tint="@color/smartbus_primary" />

    <TextView
        android:id="@+id/titleText"
        style="@style/TextAppearance.Passenger.LoginTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:gravity="center"
        android:text="@string/login_title"
        android:textColor="@color/smartbus_text_primary" />

    <TextView
        android:id="@+id/subtitleText"
        style="@style/TextAppearance.Passenger.LoginBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="@string/login_subtitle"
        android:textColor="@color/smartbus_text_secondary" />

    <LinearLayout
        android:id="@+id/startupLoading"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/spacing_xl">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            app:cardBackgroundColor="@color/smartbus_surface"
            app:cardCornerRadius="@dimen/radius_xxl"
            app:cardElevation="@dimen/elevation_card_raised"
            app:strokeColor="@color/smartbus_outline"
            app:strokeWidth="1dp">

            <ImageView
                android:layout_width="@dimen/icon_xl"
                android:layout_height="@dimen/icon_xl"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_passenger_bus"
                app:tint="@color/smartbus_primary" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/TextAppearance.Passenger.LoginTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:gravity="center"
            android:text="@string/splash_title" />

        <TextView
            style="@style/TextAppearance.Passenger.LoginBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:gravity="center"
            android:text="@string/splash_subtitle" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/splashProgress"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:indeterminate="true"
            app:indicatorColor="@color/smartbus_primary"
            app:trackColor="@color/smartbus_primary_container"
            app:trackCornerRadius="999dp" />

        <TextView
            style="@style/TextAppearance.Material3.BodySmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/splash_loading"
            android:textColor="@color/smartbus_text_secondary" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/authCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Passenger.LoginCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/radius_xl"
            app:cardElevation="@dimen/elevation_card_raised">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/fullNameLayout"
                    style="@style/Widget.Passenger.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/full_name_hint"
                    app:startIconDrawable="@drawable/ic_passenger_person"
                    app:startIconTint="@color/smartbus_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/fullNameInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:minHeight="52dp"
                        android:textColor="@color/smartbus_text_primary"
                        android:textColorHint="@color/smartbus_text_secondary" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/phoneLayout"
                    style="@style/Widget.Passenger.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:hint="@string/phone_hint"
                    app:startIconDrawable="@drawable/ic_passenger_person"
                    app:startIconTint="@color/smartbus_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/phoneInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="phone"
                        android:minHeight="52dp"
                        android:textColor="@color/smartbus_text_primary"
                        android:textColorHint="@color/smartbus_text_secondary" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/usernameLayout"
                    style="@style/Widget.Passenger.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:hint="@string/login_identifier_hint"
                    app:startIconDrawable="@drawable/ic_passenger_person"
                    app:startIconTint="@color/smartbus_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/usernameInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:minHeight="52dp"
                        android:textColor="@color/smartbus_text_primary"
                        android:textColorHint="@color/smartbus_text_secondary" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/passwordLayout"
                    style="@style/Widget.Passenger.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:hint="@string/password_hint"
                    app:boxBackgroundColor="@color/smartbus_surface"
                    app:endIconMode="password_toggle"
                    app:startIconDrawable="@drawable/ic_passenger_lock"
                    app:startIconTint="@color/smartbus_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/passwordInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:minHeight="52dp"
                        android:textColor="@color/smartbus_text_primary"
                        android:textColorHint="@color/smartbus_text_secondary" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/confirmPasswordLayout"
                    style="@style/Widget.Passenger.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:hint="@string/confirm_password_hint"
                    app:boxBackgroundColor="@color/smartbus_surface"
                    app:endIconMode="password_toggle"
                    app:startIconDrawable="@drawable/ic_passenger_lock"
                    app:startIconTint="@color/smartbus_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/confirmPasswordInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:minHeight="52dp"
                        android:textColor="@color/smartbus_text_primary"
                        android:textColorHint="@color/smartbus_text_secondary" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/authProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorColor="@color/smartbus_primary"
                    app:trackColor="@color/smartbus_primary_container" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/loginButton"
                        style="@style/Widget.Passenger.Button.Primary"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/button_height_large"
                        android:layout_weight="1"
                        android:text="@string/login_action"
                        android:textColor="@color/white"
                        app:icon="@drawable/ic_passenger_check" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/registerButton"
                        style="@style/Widget.Passenger.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/button_height_large"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="@string/register_action" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </ScrollView>

    <LinearLayout
        android:id="@+id/appContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView
                android:id="@+id/homeTab"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="16dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/smartbus_surface"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:id="@+id/homeGreetingText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/smartbus_text_primary"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/homeSummaryText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/empty_default"
                                android:textColor="@color/smartbus_text_secondary"
                                android:textSize="15sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/homeFindRouteButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/find_route_action"
                        android:textColor="@color/white"
                        app:backgroundTint="@color/smartbus_primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/homeMyTripButton"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/my_trip_tab"
                        android:textColor="@color/smartbus_primary"
                        app:strokeColor="@color/smartbus_primary" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/aiCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:cardBackgroundColor="@color/smartbus_surface"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/ai_title"
                                android:textColor="@color/smartbus_text_primary"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:id="@+id/aiMessagesContainer"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="vertical" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/aiQuestionLayout"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:hint="@string/ai_question_hint"
                                app:boxBackgroundColor="@color/smartbus_surface"
                                app:hintTextColor="@color/smartbus_primary">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/aiQuestionInput"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="textMultiLine"
                                    android:maxLines="3"
                                    android:textColor="@color/smartbus_text_primary"
                                    android:textColorHint="@color/smartbus_text_secondary" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.progressindicator.LinearProgressIndicator
                                android:id="@+id/aiProgress"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:indeterminate="true"
                                android:visibility="gone" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:orientation="horizontal">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/aiWhereBusButton"
                                    style="@style/Widget.Material3.Button.OutlinedButton"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/ai_where_bus"
                                    android:textColor="@color/smartbus_primary"
                                    app:strokeColor="@color/smartbus_primary" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/aiStopsButton"
                                    style="@style/Widget.Material3.Button.OutlinedButton"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:layout_weight="1"
                                    android:text="@string/ai_remaining_stops"
                                    android:textColor="@color/smartbus_primary"
                                    app:strokeColor="@color/smartbus_primary" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="horizontal">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/aiSendButton"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/ai_send"
                                    android:textColor="@color/white"
                                    app:backgroundTint="@color/smartbus_primary" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/aiSummaryButton"
                                    style="@style/Widget.Material3.Button.OutlinedButton"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:layout_weight="1"
                                    android:text="@string/ai_summary"
                                    android:textColor="@color/smartbus_primary"
                                    app:strokeColor="@color/smartbus_primary" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </ScrollView>

            <LinearLayout
                android:id="@+id/mapTab"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <org.osmdroid.views.MapView
                        android:id="@+id/mapView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top"
                        android:layout_margin="10dp"
                        android:orientation="vertical">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="@color/smartbus_surface"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="3dp">

                            <TextView
                                android:id="@+id/mapStatusText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="12dp"
                                android:text="@string/map_empty"
                                android:textColor="@color/smartbus_text_primary"
                                android:textSize="14sp" />
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/recenterMapButton"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/recenter_map_action"
                            android:textColor="@color/smartbus_primary"
                            app:backgroundTint="@color/smartbus_surface"
                            app:strokeColor="@color/smartbus_primary" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <ScrollView
                android:id="@+id/routesTab"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="16dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/routeSearchLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/route_search_hint"
                        app:boxBackgroundColor="@color/smartbus_surface"
                        app:hintTextColor="@color/smartbus_primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/routeSearchInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:textColor="@color/smartbus_text_primary"
                            android:textColorHint="@color/smartbus_text_secondary" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/routesStateText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/loading_default"
                        android:textColor="@color/smartbus_text_secondary"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:id="@+id/routesContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/routeDetailCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:cardBackgroundColor="@color/smartbus_surface"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:id="@+id/routeDetailText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/route_detail_empty"
                                android:textColor="@color/smartbus_text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:id="@+id/stopsContainer"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="vertical" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/boardingTitleText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/boarding_title"
                        android:textColor="@color/smartbus_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/boardingStopSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@null" />

                    <Spinner
                        android:id="@+id/destinationStopSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@null" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/findTripsButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/find_trips_action"
                        android:textColor="@color/white"
                        app:backgroundTint="@color/smartbus_primary" />

                    <LinearLayout
                        android:id="@+id/tripsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </ScrollView>

            <ScrollView
                android:id="@+id/myTripTab"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="@string/my_trip_tab"
                        android:textColor="@color/smartbus_text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/smartbus_surface"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:id="@+id/trackingText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/empty_default"
                                android:textColor="@color/smartbus_text_primary"
                                android:textSize="15sp" />

                            <ProgressBar
                                android:id="@+id/tripProgress"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:max="100" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:cardBackgroundColor="@color/smartbus_surface"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/bluetooth_title"
                                android:textColor="@color/smartbus_text_primary"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/bluetoothStatusText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/empty_default"
                                android:textColor="@color/smartbus_text_secondary"
                                android:textSize="15sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/checkInButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="@string/bluetooth_checkin_action"
                                android:textColor="@color/white"
                                app:backgroundTint="@color/smartbus_primary" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="@string/boarding_stop_label"
                                android:textColor="@color/smartbus_text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/nearbyBoardingStopText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/boarding_stop_not_selected"
                                android:textColor="@color/smartbus_text_secondary"
                                android:textSize="15sp" />

                            <Spinner
                                android:id="@+id/nearbyBoardingStopSpinner"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginTop="4dp"
                                android:background="@null"
                                android:enabled="false" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/nearbyPickBoardingStopButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:enabled="false"
                                android:text="Chọn bến đi"
                                android:textColor="@color/smartbus_primary"
                                app:backgroundTint="@color/smartbus_surface"
                                app:strokeColor="@color/smartbus_primary"
                                app:strokeWidth="1dp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="@string/destination_stop_label"
                                android:textColor="@color/smartbus_text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <Spinner
                                android:id="@+id/nearbyDestinationStopSpinner"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginTop="4dp"
                                android:background="@null"
                                android:enabled="false" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/nearbyPickDestinationStopButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:enabled="false"
                                android:text="Chọn bến xuống"
                                android:textColor="@color/smartbus_primary"
                                app:backgroundTint="@color/smartbus_surface"
                                app:strokeColor="@color/smartbus_primary"
                                app:strokeWidth="1dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/nearbyConfirmCheckInButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:enabled="true"
                                android:text="@string/nearby_confirm_checkin"
                                android:textColor="@color/white"
                                app:backgroundTint="@color/smartbus_success" />

                            <LinearLayout
                                android:id="@+id/nearbyTripsContainer"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:orientation="vertical" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/requests_title"
                        android:textColor="@color/smartbus_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/requestsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </ScrollView>

            <ScrollView
                android:id="@+id/profileTab"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="16dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/smartbus_surface"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:id="@+id/profileText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/smartbus_text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/logoutButton"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="@string/logout_action"
                                android:textColor="@color/smartbus_error"
                                app:strokeColor="@color/smartbus_error" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </ScrollView>
        </FrameLayout>

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/passengerBottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="@dimen/passenger_bottom_nav_height"
            android:background="@color/smartbus_surface"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:minHeight="@dimen/passenger_bottom_nav_height"
            app:itemIconTint="@color/passenger_bottom_nav_color"
            app:itemPaddingBottom="12dp"
            app:itemPaddingTop="8dp"
            app:itemRippleColor="@color/smartbus_primary_container"
            app:itemTextColor="@color/passenger_bottom_nav_color"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/passenger_bottom_nav_menu" />
    </LinearLayout>
</LinearLayout>
